{
  "name": "nila-drag-and-drop-website-builder",
  "private": true,
  "version": "0.18.1-beta.1",
  "type": "module",
  "description": "Local-first, open-source drag-and-drop React + Vite website builder.",
  "scripts": {
    "start": "vite --host 127.0.0.1 --open",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --open",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run test && npm run typecheck && npm run build",
    "verify": "npm run check && npm run audit:prod",
    "doctor": "node scripts/nila.mjs doctor",
    "repair": "node scripts/nila.mjs repair",
    "update": "node scripts/nila.mjs update",
    "setup": "node scripts/nila.mjs repair",
    "vendor:sync": "node scripts/sync-shadcnspace.mjs"
  },
  "engines": { "node": ">=22.0.0" },
  "dependencies": { "@dnd-kit/core":"^6.3.1", "@dnd-kit/sortable":"^10.0.0", "@dnd-kit/utilities":"^3.2.2", "fflate":"^0.8.3", "lucide-react":"^1.61.0", "react":"^19.3.1", "react-dom":"^19.3.1" },
  "devDependencies": { "@types/react":"^19.0.0", "@types/react-dom":"^19.0.0", "@vitejs/plugin-react":"^6.1.2", "typescript":"^7.0.2", "vite":"^8.3.4", "vitest":"^5.0.5" },
  "license": "Apache-2.0",
  "repository": { "type":"git", "url":"git+https://github.com/nadeemmhdm/nila-drag-and-drop-website-builder.git" }
}
